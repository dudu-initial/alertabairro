# AlertaBairro runtime defaults (copy to .env and adjust)
ALERTABAIRRO_HOST=127.0.0.1
ALERTABAIRRO_PORT=8000

# Hospedagem: conexão PostgreSQL privada, configurada no painel da Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Alternativa: deixe a senha fora da URL e configure este segredo separado.
# DATABASE_PASSWORD=
ALERTABAIRRO_DB=data/alertabairro.sqlite3
